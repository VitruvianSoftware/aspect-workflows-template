"""Developer + CI tasks for the template repo itself.

`aspect render-preset --preset <name> --out <dir>` renders a single preset from
the local `template/` tree using the shared renderer + this repo's
`template-config.json`. This is the same renderer `aspect init` uses, so testing
here proves the template renders. It's also what the CI matrix and the
`aspect-starters` publish job invoke.

The renderer itself, and the application-stamping tasks (`check-metadata`,
`render-app`, `check-renders`), are NOT defined here: they live under
`template/tools/initializer/` so they ship inside every rendered starter. This
file loads them from there, so the AWT repo and a starter run the same code.
"""

load("./template/tools/initializer/engine/render.axl", "load_config", "preset_flags", "render")

# The application-stamping tasks live with the engine they drive, under
# `template/tools/initializer/`, because that whole directory is rendered
# verbatim into every starter (ADR-026): one copy of the tasks runs both here and
# in every repo stamped from this one. This file only re-exports them so
# `MODULE.aspect` keeps naming a single tasks file for the AWT repo.
load(
    "./template/tools/initializer/tasks.axl",
    _check_metadata = "check_metadata",
    _check_renders = "check_renders",
    _render_app = "render_app",
)

check_metadata = _check_metadata
render_app = _render_app
check_renders = _check_renders

# Backstage presets ship a software-template (template.yaml) whose `skeleton/`
# must contain a concrete copy of the rendered project so Backstage's scaffolder
# can re-emit it. The old engine did this in hooks/post_scaffold; the new renderer
# has no hook, so we replicate it here (the local/CI/delivery render path). Copies
# every rendered file except the Backstage meta files, paths preserved, names
# concrete (only the hand-authored skeleton/* files carry ${{ values.* }}).
_SKELETON_EXCLUDE_TOP = ["template.yaml", "catalog-info.yaml", "skeleton", "README.md", "README.bazel.md"]

def _populate_skeleton(ctx, out, written):
    skel = out + "/skeleton"
    copied = 0
    for rel in written:
        if rel.split("/")[0] in _SKELETON_EXCLUDE_TOP:
            continue
        dst = skel + "/" + rel
        if ctx.std.fs.exists(dst):
            continue
        ctx.std.fs.create_dir_all(dst.rsplit("/", 1)[0])
        ctx.std.fs.copy(out + "/" + rel, dst)
        copied += 1
    ctx.std.io.stdout.write("  backstage: copied {} files into skeleton/\n".format(copied))

# render-preset clears --out before rendering, and `--out=$HOME` used to delete
# $HOME (#45). Canonicalize ONCE and refuse any directory whose removal would
# destroy something that is not a render: the filesystem root, the home
# directory, and this repository or any directory containing it. Same
# canonicalize-once rule as render-app (template/tools/initializer/tasks.axl):
# every spelling of a path (`x/`, `x/.`, `y/../x`, relative) resolves to one
# value before it is compared or removed. Symlinks are not resolved.
def _canonical(ctx, path):
    if not path.startswith("/"):
        path = ctx.std.env.current_dir() + "/" + path
    segs = []
    for s in path.split("/"):
        if s == "" or s == ".":
            continue
        if s == "..":
            if segs:
                segs.pop()
            continue
        segs.append(s)
    return "/" + "/".join(segs)

def _safe_out(ctx, raw, repo_dir):
    out = _canonical(ctx, raw)
    if out == "/":
        fail("--out={!r} resolves to the filesystem root, which render-preset would delete; pass a fresh directory".format(raw))
    home = ctx.std.env.var("HOME") or ""
    if home and out == _canonical(ctx, home):
        fail("--out={!r} resolves to the home directory, which render-preset would delete; pass a fresh directory".format(raw))
    repo = _canonical(ctx, repo_dir)
    if repo == out or repo.startswith(out + "/"):
        fail("--out={!r} resolves to {}, which is or contains this repository; render-preset would delete it. Pass a directory outside the checkout".format(raw, out))
    return out

def _impl(ctx):
    repo_dir = ctx.std.env.current_dir()
    config = load_config(ctx, repo_dir)

    preset = ctx.args.preset
    name = ctx.args.name

    flags = dict(preset_flags(config, preset))

    # Mirror `aspect init`'s --license: defaults to "none"; the aspect-starters
    # publish job passes --license=Apache-2.0 to include it.
    flags["license"] = ctx.args.license != "none"
    template_dir = repo_dir + "/template"

    # --out is DELETED before rendering, so it is canonicalized once here and
    # only `out` (never the raw argument) is used below; see _safe_out.
    out = _safe_out(ctx, ctx.args.out, repo_dir)
    if ctx.std.fs.exists(out):
        ctx.std.fs.remove_dir_all(out)
    ctx.std.fs.create_dir_all(out)

    written = render(ctx, config, template_dir, out, name, flags)
    ctx.std.io.stdout.write("rendered preset {!r} -> {} ({} files)\n".format(preset, out, len(written)))

    if flags.get("backstage", False):
        _populate_skeleton(ctx, out, written)

    return 0

# NB: --preset has no static `values=` list because the valid presets are read
# at runtime from template-config.json (preset_flags fails on an unknown name).
render_preset = task(
    kind = "render-preset",
    summary = "Render one template preset into an output directory",
    implementation = _impl,
    args = {
        "preset": args.string(required = True, description = "Preset to render (see template-config.json)"),
        "out": args.string(required = True, description = "Output directory; deleted and recreated. Refuses /, $HOME and this checkout or any directory containing it"),
        "name": args.string(default = "my_project", description = "Project name (snake_case)"),
        "license": args.string(default = "none", values = ["Apache-2.0", "none"], description = "License to scaffold; defaults to 'none'. Pass 'Apache-2.0' to include it."),
    },
)
